notes.md

# Python
__pycache__/
*.pyc
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
.coverage
htmlcov/

# Data (raw/bronze/silver/gold are large and regenerated by pipelines/
# downloaded by src/ingest/download.py - never committed)
data/raw/*
data/raw/*/*
data/bronze/*
data/silver/*
data/gold/*
data/tmp/*
data/synthetic/*
!data/raw/*/
!data/**/.gitkeep
# data/audit/ is the evidence behind the runbook and is tracked in full (no
# ignore rule for its folders). Only model binaries are kept out, as a guard
# against committing a large artifact by accident; there are none today.
data/audit/**/*.npz
data/audit/**/*.pkl
data/audit/**/*.pt
data/audit/**/*.pth
data/audit/**/*.joblib
# Logs that contain the repository's absolute path (warnings, uv and MLflow
# messages) break the no-absolute-paths rule, so they stay local. Logs without
# such paths are tracked.
data/audit/agent_models_h30_seed0/*.log
data/audit/cascade_logs/cascade_wide_net_h30.log
data/audit/q3_logs/cascade_h*.log
data/audit/q3_logs/train_h*.log
data/audit/q3_logs/deep_dive*.log
data/audit/q3_logs/cluster_policy_validation.log
data/audit/stack_scorer_h60_logs/freeze.log

# ML experiment tracking artifacts
mlflow/*
!mlflow/.gitkeep
mlruns/
mlartifacts/

# Golden dataset artifact is regenerated by tests/golden/generate_golden_dataset.py
tests/golden/golden_dataset.parquet

# vscode settings
.vscode/
# Audit database (local state). The test-access log is tracked; see
# .gitattributes (merge=union, it is append-only).
data/audit/*.sqlite*

delme/
